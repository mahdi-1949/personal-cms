# These are examples only. Export them in your shell or hosting dashboard.
# No automatic .env loader is included.
CMS_HOST=127.0.0.1
CMS_PORT=3000
CMS_DB_PATH=./data/cms.sqlite
# Default: a media directory next to the database. Keep this outside the source tree.
CMS_MEDIA_DIR=./data/media
CMS_ORIGIN=http://localhost:3000
CMS_PUBLIC_URL=https://example.com
# For GitHub project Pages: https://YOUR-ACCOUNT.github.io/YOUR-REPOSITORY
# CMS_SECURE_COOKIES=1 requires HTTPS; use for production behind a reverse proxy.
CMS_SECURE_COOKIES=0

# Generate a random 32-byte base64 key and keep it in private deployment secrets.
# Required for MFA / SMTP. Preserve it separately when backing up this install.
CMS_SECURITY_KEY=
CMS_REQUIRE_ADMIN_MFA=0
# Only exact IP addresses of your reverse proxy, separated by commas. Empty = no trust.
CMS_TRUSTED_PROXY_IPS=
# Password recovery and security notices are disabled unless SMTP is configured.
CMS_SMTP_HOST=
CMS_SMTP_PORT=465
CMS_SMTP_SECURE=1
CMS_SMTP_USER=
CMS_SMTP_PASSWORD=
CMS_MAIL_FROM=
